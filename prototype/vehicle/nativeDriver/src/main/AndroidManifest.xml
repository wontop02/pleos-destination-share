<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <application android:label="Native SDK test driver" android:allowBackup="false" android:testOnly="true">
        <activity android:name=".SpeechProbeActivity" android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity android:name=".SearchScreenProbeActivity" android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
    <instrumentation android:name=".NativeDestinationDriver"
        android:targetPackage="ai.pleos.destinations.driver" android:functionalTest="true" />
    <instrumentation android:name=".VehicleUiTextProbe"
        android:targetPackage="ai.pleos.destinations.driver" android:functionalTest="true" />
    <instrumentation android:name=".VehicleUiActionProbe"
        android:targetPackage="ai.pleos.destinations.driver" android:functionalTest="true" />
</manifest>
